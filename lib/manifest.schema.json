{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://manifestx.dev/manifest.schema.json",
    "title": "Manifest project configuration",
    "description": "Combined PWA manifest and Manifest framework configuration. See https://manifestx.dev/docs/getting-started/setup.",
    "type": "object",
    "additionalProperties": true,
    "properties": {
        "$schema": {
            "type": "string",
            "format": "uri"
        },
        "name": {
            "type": "string",
            "description": "Full application name shown by the OS and browsers."
        },
        "short_name": {
            "type": "string",
            "description": "Short name used on home screens and limited-width contexts."
        },
        "description": {
            "type": "string"
        },
        "author": {
            "type": "string"
        },
        "email": {
            "type": "string",
            "format": "email"
        },
        "live_url": {
            "type": "string",
            "format": "uri",
            "description": "Production URL — used by the prerender pipeline for canonical/sitemap output."
        },
        "start_url": {
            "type": "string",
            "default": "/"
        },
        "scope": {
            "type": "string",
            "default": "/"
        },
        "display": {
            "type": "string",
            "enum": ["fullscreen", "standalone", "minimal-ui", "browser"]
        },
        "orientation": {
            "type": "string",
            "enum": ["any", "natural", "landscape", "landscape-primary", "landscape-secondary", "portrait", "portrait-primary", "portrait-secondary"]
        },
        "background_color": {
            "type": "string",
            "pattern": "^#([0-9A-Fa-f]{3}){1,2}$"
        },
        "theme_color": {
            "type": "string",
            "pattern": "^#([0-9A-Fa-f]{3}){1,2}$"
        },
        "icons": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["src"],
                "properties": {
                    "src": { "type": "string" },
                    "sizes": { "type": "string" },
                    "type": { "type": "string" },
                    "purpose": { "type": "string" }
                }
            }
        },
        "components": {
            "type": "array",
            "description": "Component HTML files registered as <x-name> tags.",
            "items": { "type": "string" }
        },
        "preloadedComponents": {
            "type": "array",
            "description": "Components loaded eagerly on initial page load (header, logo, etc.).",
            "items": { "type": "string" }
        },
        "data": {
            "type": "object",
            "description": "Named data sources made available via $x.<sourceName>. Each value is either a string path/URL or a config object.",
            "additionalProperties": {
                "oneOf": [
                    {
                        "type": "string",
                        "description": "Path to a CSV, JSON, or YAML file, or an absolute HTTP URL."
                    },
                    {
                        "type": "object",
                        "description": "Localized source, HTTP source with config, or Appwrite-backed source.",
                        "properties": {
                            "url": {
                                "type": "string",
                                "description": "HTTP endpoint URL."
                            },
                            "headers": {
                                "type": "object",
                                "additionalProperties": { "type": "string" }
                            },
                            "params": {
                                "type": "object"
                            },
                            "transform": {
                                "type": "string",
                                "description": "Optional dot-path into the response body (e.g. 'data.items')."
                            },
                            "defaultValue": {
                                "description": "Value used while loading or on error."
                            },
                            "locales": {
                                "type": "string",
                                "description": "Single CSV with locale columns; locale resolution happens internally."
                            },
                            "appwriteTableId": { "type": "string" },
                            "appwriteBucketId": { "type": "string" },
                            "appwriteDatabaseId": { "type": "string" },
                            "appwriteProjectId": { "type": "string" },
                            "appwriteEndpoint": { "type": "string" },
                            "appwriteDevKey": { "type": "string" },
                            "scope": {
                                "oneOf": [
                                    { "type": "string", "enum": ["user", "team"] },
                                    { "type": "array", "items": { "type": "string", "enum": ["user", "team"] } }
                                ]
                            },
                            "autoInjectUserId": { "type": "boolean" },
                            "autoInjectTeamId": { "type": "boolean" },
                            "queries": {
                                "type": "array",
                                "items": { "type": "string" }
                            },
                            "storage": {
                                "type": "object",
                                "description": "Map of storage-bucket source names to the column on this row that holds their file IDs.",
                                "additionalProperties": { "type": "string" }
                            },
                            "throttle": { "type": "number" },
                            "cleanupInterval": { "type": "number" },
                            "minChangeThreshold": { "type": "number" },
                            "idleThreshold": { "type": "number" },
                            "enableVisualRendering": { "type": "boolean" },
                            "includeVelocity": { "type": "boolean" }
                        },
                        "additionalProperties": true
                    }
                ]
            }
        },
        "appwrite": {
            "type": "object",
            "description": "Appwrite global configuration. Per-source overrides live on the data entry.",
            "properties": {
                "projectId": { "type": "string" },
                "endpoint": { "type": "string", "format": "uri" },
                "databaseId": { "type": "string" },
                "devKey": {
                    "type": "string",
                    "description": "May reference an env var via ${VAR_NAME}."
                },
                "auth": {
                    "type": "object",
                    "properties": {
                        "methods": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "enum": ["guest", "guest-auto", "guest-manual", "magic", "otp", "oauth", "password"]
                            }
                        },
                        "teams": {
                            "type": "object",
                            "properties": {
                                "permanent": { "type": "array", "items": { "type": "string" } },
                                "template": { "type": "array", "items": { "type": "string" } },
                                "guests": { "type": "boolean", "description": "Seed permanent/template teams for guest (anonymous) sessions too. Off by default." }
                            }
                        },
                        "guestUpgrade": { "type": "boolean", "description": "Preserve a guest's account (and its teams) when they sign in, instead of replacing it. Works with magic links and OAuth; email OTP cannot convert anonymous accounts (Appwrite limitation). Defaults to the value of teams.guests." },
                        "guestMigration": {
                            "type": "object",
                            "description": "Carry a guest's teams over to the account they sign into via email OTP (which cannot convert in place). Requires the deployed guest-migration Appwrite Function — see templates/guest-migration-function.",
                            "properties": {
                                "functionId": { "type": "string", "description": "Id of the deployed guest-migration function." }
                            }
                        },
                        "roles": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "array",
                                    "items": { "type": "string" }
                                }
                            }
                        },
                        "creatorRole": { "type": "string" },
                        "creatorRoles": {
                            "description": "Role(s) the team creator is assigned atomically at creation. null or [] = owner-only (creator holds just Appwrite's intrinsic owner; no template role). Takes precedence over creatorRole.",
                            "oneOf": [
                                { "type": "string" },
                                { "type": "array", "items": { "type": "string" } },
                                { "type": "null" }
                            ]
                        }
                    }
                }
            }
        },
        "status": {
            "type": "object",
            "description": "Named, top-level-addressable status signals exposed via $status.<name>. Each entry rolls up one or more underlying signals into a single health state. Signal layer only — the author renders their own UI.",
            "additionalProperties": {
                "oneOf": [
                    {
                        "type": "string",
                        "description": "Shorthand: an HTTP URL probed for reachability/latency."
                    },
                    {
                        "type": "array",
                        "description": "Multiple signals rolled up (worst-of by default).",
                        "items": { "$ref": "#/definitions/statusSignal" }
                    },
                    {
                        "type": "object",
                        "description": "A single signal, or an aggregate via `signals` with rollup options.",
                        "properties": {
                            "signals": {
                                "type": "array",
                                "items": { "$ref": "#/definitions/statusSignal" }
                            },
                            "rollup": {
                                "type": "string",
                                "enum": ["worst", "best"],
                                "default": "worst"
                            },
                            "refresh": {
                                "type": "number",
                                "description": "Poll interval in milliseconds (default 30000)."
                            },
                            "confirmations": {
                                "type": "number",
                                "description": "Consecutive observations required before a state change (hysteresis)."
                            },
                            "staleAfter": {
                                "type": "number",
                                "description": "Milliseconds without a known signal before the entry reads as stale (default refresh × 3)."
                            }
                        },
                        "additionalProperties": true
                    }
                ]
            }
        },
        "render": {
            "type": "object",
            "description": "Static rendering configuration consumed by mnfst-render.",
            "properties": {
                "localUrl": { "type": "string", "format": "uri" },
                "liveUrl": { "type": "string", "format": "uri" },
                "output": { "type": "string", "default": "dist" },
                "routerBase": { "type": "string", "default": "" },
                "locales": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            },
            "additionalProperties": true
        }
    },
    "definitions": {
        "statusSignal": {
            "description": "One health input. Provider is inferred by which field is present.",
            "oneOf": [
                {
                    "type": "string",
                    "description": "An HTTP URL probed for reachability/latency."
                },
                {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                        "label": { "type": "string" },
                        "url": { "type": "string", "description": "HTTP probe target." },
                        "expect": { "type": "number", "description": "Exact status code to treat as operational (default: any 2xx)." },
                        "degradedAbove": { "type": "number", "description": "Latency in ms above which the probe reads as degraded." },
                        "method": { "type": "string" },
                        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                        "timeout": { "type": "number" },
                        "static": { "type": "string", "description": "Literal state (operational | degraded | partial_outage | major_outage | maintenance)." },
                        "feed": { "type": "string", "description": "URL returning JSON whose state field is read." },
                        "path": { "type": "string", "description": "Dot-path into a feed response to the state value." },
                        "mirror": { "type": "string", "description": "Named upstream whose own status feed is reflected (e.g. 'appwrite')." },
                        "appwriteService": { "type": "string", "description": "Resolves against the global appwrite endpoint's /health." },
                        "mcp": { "type": "string", "description": "Hosted (Manifest MCP) signal; a feed URL when self-resolving." },
                        "heartbeat": { "type": "string", "description": "Dead-man's-switch key; call $status.beat(key) to pulse." },
                        "expectEvery": { "type": "number", "description": "Heartbeat window in ms before it reads as down." }
                    }
                }
            ]
        }
    }
}
