            "locales": "/test/data/dp-ui.csv"
        },
        "yaml": "/test/data/test.yaml",
        "yamlArray": "/test/data/test-array.yaml",
        "projects": {
            "appwriteTableId": "projects",
            "appwriteDatabaseId": "69272017000296721b73",
            "scope": [
                "user",
                "team"
            ],
            "storage": {
                "assets": "fileIds"
            }
        },
        "assets": {
            "appwriteBucketId": "69285cd300373b8ddb7f"
        },
        "presence": {
            "appwriteTableId": "presence",
            "appwriteDatabaseId": "69272017000296721b73",
            "throttle": 300,
            "cleanupInterval": 30000,
            "minChangeThreshold": 5,
            "idleThreshold": 5000,
            "enableVisualRendering": true,
            "includeVelocity": false
        }
    },
    "colorpicker": "colors",
    "payments": {
        "provider": "mockpay",
        "endpoint": "https://fn.test/pay"
    },
    "appwrite": {
        "projectId": "68cfcc610014415b6f9a",
        "endpoint": "${PUBLIC_APPWRITE_ENDPOINT}",
        "devKey": "${PUBLIC_APPWRITE_DEV_KEY}",
        "auth": {
            "methods": [
                "guest-manual",
                "magic",
                "otp",
                "oauth"
            ],
            "teams": {
                "permanent": [
                    "Permanent Workspace"
                ],
                "template": [
                    "Template Workspace",
                    "Dream Team"
                ]
            },
            "roles": {
                "permanent": {
                    "Admin": [
                        "inviteMembers",
                        "updateMembers",
                        "removeMembers",
                        "manageRoles",
                        "renameTeam",
                        "deleteTeam"
                    ]
                },
                "template": {
                    "Editor": [
                        "inviteMembers"
                    ]
                }
            },
            "creatorRole": "Admin"
        }
    },
    "status": {
        "Website": {
            "signals": [
                {
                    "url": "/manifest.json",
                    "label": "home"
                },
                {
                    "url": "/index.html",
                    "label": "app"
                }
            ],
            "rollup": "worst",
            "refresh": 15000
        },
        "API": {
            "url": "/manifest.json",
            "degradedAbove": 1,
            "label": "api",
            "refresh": 15000
        },
        "Database": {
            "static": "operational"
        },
        "CDN": {
            "static": "operational"
        },
        "Search": {
            "static": "maintenance"
        },
        "Workers": {
            "static": "major_outage"
        }
    },
    "render": {
        "localUrl": "http://localhost:5001",
        "liveUrl": "https://test.com",
        "output": "test-prerender",
        "routerBase": ""
    }
