{
  "name": "mnfst-test",
  "version": "0.1.9",
  "description": "Testing toolkit for Manifest projects \u2014 `mnfst-test` CLI for project linting, a fake Appwrite backend that Manifest's real data plugins run on, golden-journey screenshot tests in a real browser, and `mountManifest()` for component tests with Vitest + happy-dom",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./fake": "./fake.mjs",
    "./fixtures": "./fixtures.mjs",
    "./browser": "./browser.mjs"
  },
  "bin": {
    "mnfst-test": "./bin/mnfst-test.js"
  },
  "files": [
    "bin",
    "index.mjs",
    "manifest.test.mjs",
    "fake.mjs",
    "fixtures.mjs",
    "browser.mjs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "manifest",
    "mnfst",
    "test",
    "testing",
    "lint",
    "check",
    "validation",
    "vitest",
    "happy-dom",
    "ai",
    "appwrite",
    "fake",
    "screenshot",
    "visual-regression",
    "e2e"
  ],
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "happy-dom": ">=12",
    "puppeteer": ">=22"
  },
  "peerDependenciesMeta": {
    "happy-dom": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    }
  },
  "author": "Andrew Matlock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manifest-X/Manifest.git",
    "directory": "packages/test"
  }
}
